          "id": "ff3d5aae-9350-466f-981d-7347a5719880",
          "name": "Get visitor profile",
          "request": {
            "name": "Get visitor profile",
            "description": {
              "content": "Retrieves the full visitor profile for a specific visitor identified by a Visitor ID attribute value. Supports live data, historical data, or both. Returns audience memberships, badges, and all configured attribute values. Maximum of 150 attribute IDs can be filtered per request.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "customer",
                "visitor",
                "accounts",
                ":account",
                "profiles",
                ":profile"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "attributeId",
                  "value": "<integer>",
                  "description": "(Required) Numeric ID of the Visitor ID attribute"
                },
                {
                  "disabled": false,
                  "key": "attributeValue",
                  "value": "<string>",
                  "description": "(Required) Value to look up (URL-encode special characters)"
                },
                {
                  "disabled": false,
                  "key": "prettyName",
                  "value": "false",
                  "description": "When true, returns user-friendly attribute names; when false, returns numeric IDs"
                },
                {
                  "disabled": false,
                  "key": "searchPriority",
                  "value": "<string>",
                  "description": "JSON array controlling search order. Defaults to [\"live\",\"historical\"]. Options: [\"live\"], [\"historical\"], or [\"live\",\"historical\"]"
                },
                {
                  "disabled": false,
                  "key": "responseFilters",
                  "value": "<string>",
                  "description": "JSON array of up to 150 attribute IDs to include in response. Omit to return all attributes."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "account",
                  "description": "(Required) Tealium account name"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "profile",
                  "description": "(Required) Tealium profile name"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
