          "name": "Generate bearer token",
          "request": {
            "name": "Generate bearer token",
            "description": {
              "content": "Exchanges a username (email address) and API key for a JWT bearer token and a region-specific host. The returned token is valid for 30 minutes and should be reused across API calls rather than regenerated on each request. Use the returned host value for all subsequent API calls to ensure regional routing.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "auth",
                "accounts",
                ":account",
                "profiles",
                ":profile"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "account",
                  "description": "(Required) Tealium account name"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "profile",
                  "description": "(Required) Tealium profile name"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "username",
                  "value": "<email>",
                  "description": "(Required) User email address associated with the Tealium account"
                },
                {
                  "disabled": false,
                  "key": "key",
                  "value": "<string>",
                  "description": "(Required) API key from Tealium iQ Tag Management"
                }
              ]
            }
          },
