                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "engineId",
                  "description": "(Required) Unique identifier for the configured Moments engine"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "visitorId",
                  "description": "(Required) Tealium anonymous visitor ID (GUID format)"
